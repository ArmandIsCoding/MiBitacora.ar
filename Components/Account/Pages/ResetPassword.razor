@page "/Account/ResetPassword"
@layout AccessLayout
@using System.ComponentModel.DataAnnotations
@inject AccountRecoveryService Recovery

<PageTitle>Nueva contraseña · Mi Bitácora</PageTitle>
<h1>Elegí una contraseña nueva</h1>
@if (_done) { <p class="journal-notice" role="status">Guardamos tu contraseña. Las sesiones anteriores se cerrarán al verificar su seguridad.</p><a class="account-button" href="/Account/Login">Ingresar</a> }
else
{
    <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password" class="account-form">
        <DataAnnotationsValidator />
        <InputText type="hidden" @bind-Value="Input.Email" /><InputText type="hidden" @bind-Value="Input.Code" />
        <label for="reset-password">Nueva contraseña</label><InputText id="reset-password" type="password" @bind-Value="Input.Password" autocomplete="new-password" minlength="12" maxlength="128" required />
        <ValidationMessage For="() => Input.Password" />
        <label for="reset-repeat">Repetí la contraseña</label><InputText id="reset-repeat" type="password" @bind-Value="Input.Confirm" autocomplete="new-password" maxlength="128" required />
        <ValidationMessage For="() => Input.Confirm" />
        @if (_error is not null) { <p class="journal-alert" role="alert">@_error</p> }
        <button class="account-button" type="submit">Guardar contraseña</button>
    </EditForm>
    <p class="account-switch"><a href="/Account/ForgotPassword">Pedir otro enlace</a></p>
}
@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }
    [SupplyParameterFromForm] private ResetInput Input { get; set; } = default!;
    private bool _done;
    private string? _error;
    protected override void OnInitialized() => Input ??= new() { Email = Email ?? "", Code = Code ?? "" };
    private async Task ResetAsync()
    {
        var result = await Recovery.ResetAsync(Input.Email, Input.Code, Input.Password);
        _done = result.Succeeded;
        if (!_done) _error = "El enlace no es válido o venció. Pedí uno nuevo y revisá la contraseña elegida.";
    }
    private sealed class ResetInput
    {
        [Required, EmailAddress, StringLength(254)] public string Email { get; set; } = "";
        [Required, StringLength(4000)] public string Code { get; set; } = "";
        [Required, StringLength(128, MinimumLength = 12, ErrorMessage = "Usá entre 12 y 128 caracteres.")] public string Password { get; set; } = "";
        [Required, Compare(nameof(Password), ErrorMessage = "Las contraseñas tienen que coincidir.")] public string Confirm { get; set; } = "";
    }
}
