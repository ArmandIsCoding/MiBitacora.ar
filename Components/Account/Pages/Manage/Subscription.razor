@page "/Account/Manage/Subscription"
@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using MiBitacora.Data
@inject SubscriptionService Billing
@inject AiUsageService Usage
@inject UserManager<ApplicationUser> Users
@inject TimeZoneInfo TimeZone
<PageTitle>Mi plan · Mi Bitácora</PageTitle>
<h2>Mi plan</h2><p class="account-intro">Tu cuaderno y tus conversaciones siguen siendo tuyos. Acá podés ver el cupo, tus pagos y la renovación.</p>
@if (Billing.IsSimulation) { <p class="journal-notice" role="status">Entorno local: los cobros son simulados y no mueven dinero.</p> }
@if (Error is not null) { <p class="journal-alert" role="alert">@(Error == "email" ? "Confirmá el correo de tu cuenta antes de contratar." : Error == "offer" ? "La oferta cambió desde que abriste la página. Revisá el precio y las condiciones antes de continuar." : "La operación sigue sin confirmar. No iniciamos otro cobro. Actualizá el estado o contactanos para revisarlo.")</p> }
@if (Returned == "1") { <p class="journal-notice" role="status">Volviste de Mercado Pago. Profundo se activa cuando verificamos el pago aprobado. Podés actualizar el estado desde acá.</p> }
@if (Updated == "1") { <p class="journal-notice" role="status">Revisamos el estado con el proveedor. Podés ver el resultado a continuación.</p> }
@if (ProviderSaved == "1") { <p class="journal-notice" role="status">Guardamos tu elección para las próximas respuestas.</p> }
<section class="subscription-current" aria-label="Tu acceso actual"><p class="eyebrow">TU PLAN ACTUAL</p><h3>@(_access.IsPaid ? "Profundo" : "Gratuito")</h3>
    @if (_access.IsComplimentary) { <p>Acceso de cortesía, sin cobros ni renovación automática.</p> }
    @if (_access.PaidThroughUtc is { } through) { <p>Acceso pago hasta el <strong>@Date(through)</strong>.</p> }
    @if (_subscription is { } sub) {
        <p>Suscripción: <strong>@Status(sub.Status)</strong>. Precio contratado: ARS @Money(sub.MonthlyPriceCents) por mes.</p>
        @if (sub.CancellationRequested) { <p role="status">@(sub.Status is "cancelled" or "canceled" ? "Renovación cancelada. Conservás el período abonado." : "Recibimos tu baja. Estamos confirmándola con Mercado Pago y volveremos a intentar si demora. Los cobros posteriores al pedido serán reintegrados.")</p> }
        @if (sub.LastSyncedUtc is { } synced) { <p class="topic-scope">Última conciliación: @Date(synced).</p> }
        @if (sub.CheckoutUrl is { } checkout && sub.Status == "pending") { <a class="btn btn-primary" href="@checkout">Continuar en Mercado Pago</a> }
        <form method="post" action="/Account/Subscription/Refresh"><AntiforgeryToken /><button class="quiet-action" type="submit">Actualizar estado</button></form>
        @if (!sub.CancellationRequested && sub.Status is not ("cancelled" or "canceled" or "creation_failed")) {
            <details class="subscription-cancel"><summary>Cancelar renovación</summary><p>Detenemos los futuros cobros. Tu cuaderno se conserva y podés usar Profundo hasta terminar el período abonado. La baja no tiene penalidad.</p><form method="post" action="/Account/Subscription/Cancel"><AntiforgeryToken /><button class="btn btn-outline" type="submit">Confirmar baja de la renovación</button></form></details>
        }
        @if (sub.AcceptedUtc is { } accepted) { <p class="topic-scope">Condiciones @sub.TermsVersion aceptadas el @Date(accepted). Cupo contratado: @sub.MonthlyCredits créditos por período.</p> }
        @if (Billing.IsSimulation && sub.Status is not ("cancelled" or "canceled")) { <a href="@($"/Account/Subscription/Simulate/{sub.Id}")">Simulador local</a> }
    }
</section>
@if (_access.CanUseOpenAi && _usage is { } usage) {
    <section class="subscription-current" aria-label="Cupo de OpenAI"><h3>Tus créditos de este período</h3><p><strong>@usage.Used de @usage.Limit usados</strong>@(usage.Reserved > 0 ? $" · {usage.Reserved} en proceso" : "") · @usage.Remaining disponibles.</p><progress class="usage-meter" value="@(usage.Used + usage.Reserved)" max="@usage.Limit">@(usage.Used + usage.Reserved) de @usage.Limit</progress><p>Período: @Date(usage.FromUtc) a @Date(usage.ThroughUtc). No se acumulan ni generan cargos adicionales.</p>
    @if (usage.NearLimit) { <p role="status" class="journal-alert">@(usage.Remaining == 0 ? "Agotaste el cupo del período. Podés continuar con IA local, guardar y leer tu cuaderno." : "Estás cerca del cupo mensual. Podés alternar con IA local para reservar tus créditos.")</p> }
    <p>Respuesta o regeneración: 1 crédito. Cada transcripción de audio: 1 adicional. Informe completo: @Billing.Settings.ReportCredits créditos.</p>
    <form method="post" action="/Account/Subscription/AiProvider" class="account-form"><AntiforgeryToken /><label for="ai-provider">IA para las próximas respuestas</label><select id="ai-provider" name="provider" class="brisa-provider-select"><option value="OpenAI" selected="@(_access.AiProvider == "OpenAI")">OpenAI · usa créditos</option><option value="Ollama" selected="@(_access.AiProvider == "Ollama")">IA local · sin créditos de OpenAI</option></select><p class="topic-scope">Con OpenAI se envían a ese proveedor tu mensaje y el contexto pertinente. Con IA local se procesan en la infraestructura de Mi Bitácora. <a href="/privacidad">Ver privacidad</a>.</p><button class="account-button" type="submit">Guardar mi elección</button></form></section>
}
@if (!_access.IsPaid) {
<section class="subscription-current subscription-card-paid"><p class="eyebrow">PARA IR MÁS A FONDO</p><h3>Elegir Profundo</h3><p class="subscription-price">ARS @Money(Billing.Settings.PriceCents)<small> por mes · precio final</small></p><p>@Billing.Settings.MonthlyCredits créditos por período para conversar con OpenAI. Renovación mensual automática con Mercado Pago. Sin permanencia mínima ni cargos por excedentes.</p>
    @if (_user is null || !Billing.CanSubscribeFor(_user.Id)) { <p>Las nuevas contrataciones todavía no están disponibles. Podés usar el plan gratuito y <a href="/soporte">contactarnos</a>.</p> }
    else if (_user?.EmailConfirmed != true) { <p>Para proteger tu contratación, primero <a href="/Account/ResendConfirmation">confirmá el correo de tu cuenta</a>. Podés seguir usando el plan gratuito.</p> }
    else if (_subscription is null || _subscription.Status is "cancelled" or "canceled" or "creation_failed") {
        <form method="post" action="/Account/Subscription/Subscribe" class="account-form"><AntiforgeryToken /><input type="hidden" name="price" value="@Billing.Settings.PriceCents" /><input type="hidden" name="credits" value="@Billing.Settings.MonthlyCredits" /><input type="hidden" name="terms" value="@BusinessIdentity.TermsVersion" />
        <div class="account-field"><label for="payer-email">Correo de tu cuenta de Mercado Pago</label><input id="payer-email" type="email" name="payerEmail" value="@_user.Email" maxlength="254" autocomplete="email" required /><small>Puede ser distinto del correo de Mi Bitácora. Lo usaremos para las constancias de pago.</small></div>
        <label><input type="checkbox" name="accept" value="yes" required /> Soy mayor de 18 años y acepto el cobro recurrente de ARS @Money(Billing.Settings.PriceCents) por mes, el cupo de @Billing.Settings.MonthlyCredits créditos y las <a href="/condiciones">condiciones de contratación y reintegros</a>. Al usar OpenAI, mi mensaje y el contexto pertinente se procesan con ese proveedor según la <a href="/privacidad">política de privacidad</a>.</label><button class="account-button" type="submit">@(Billing.IsSimulation ? "Ir al checkout simulado" : "Continuar a Mercado Pago")</button></form>
    }
</section>
}
@if (_payments.Count > 0) {
    <h3>Historial de pagos</h3><div class="subscription-payments"><table><thead><tr><th>Período</th><th>Importe</th><th>Estado</th><th>Detalle</th></tr></thead><tbody>@foreach (var p in _payments) { <tr><td>@Date(p.FromUtc) — @Date(p.ThroughUtc)</td><td>ARS @Money(p.AmountCents)</td><td>@Status(p.Status)</td><td><a href="@($"/Account/Subscription/Receipt/{Uri.EscapeDataString(p.Id)}")">Constancia</a></td></tr> }</tbody></table></div>
}
<p class="topic-scope">Las constancias del sitio no sustituyen una factura. Para tu factura C, <a href="/soporte">contactanos</a> con la referencia del pago. @BusinessIdentity.Name · CUIT @BusinessIdentity.TaxId.</p><CommerceLinks />
@code {
    [CascadingParameter] private HttpContext Context { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "returned")] public string? Returned { get; set; }
    [SupplyParameterFromQuery(Name = "updated")] public string? Updated { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "providerSaved")] public string? ProviderSaved { get; set; }
    private SubscriptionAccess _access = SubscriptionAccess.Free;
    private SubscriptionSummary? _subscription;
    private AiUsageSnapshot? _usage;
    private ApplicationUser? _user;
    private IReadOnlyList<SubscriptionPayment> _payments = [];
    protected override async Task OnInitializedAsync() {
        _user = await Users.GetUserAsync(Context.User); if (_user is null) return;
        _access = await Billing.GetAccessAsync(_user.Id, Context.RequestAborted);
        _subscription = await Billing.GetSummaryAsync(_user.Id, Context.RequestAborted);
        _payments = await Billing.GetPaymentsAsync(_user.Id, Context.RequestAborted);
        if (_access.CanUseOpenAi) _usage = await Usage.GetAsync(_user.Id, Context.RequestAborted);
    }
    private static string Money(long cents) => (cents / 100m).ToString(cents % 100 == 0 ? "N0" : "N2", CultureInfo.GetCultureInfo("es-AR"));
    private string Date(DateTime date) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(date, DateTimeKind.Utc), TimeZone).ToString("d MMM yyyy HH:mm", CultureInfo.GetCultureInfo("es-AR"));
    private static string Status(string status) => status switch { "creating" => "Contratación por confirmar", "creation_failed" => "Contratación rechazada", "pending" => "Pendiente", "authorized" => "Renovación autorizada", "approved" => "Aprobado", "paused" => "Pausada", "cancelled" or "canceled" => "Cancelada", "refunded" => "Devuelto", "charged_back" => "Contracargo", "rejected" => "Rechazado", _ => "En proceso" };
}
