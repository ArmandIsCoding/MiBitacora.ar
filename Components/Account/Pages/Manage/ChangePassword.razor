@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using MiBitacora.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Cambiar contraseña | Mi Bitácora</PageTitle>

<h2>Cambiá tu contraseña</h2>
<p class="account-intro">Ingresá tu contraseña actual y elegí una nueva.</p>
<StatusMessage Message="@errorMessage" IsError="@(errorMessage is not null)" />

<EditForm Model="Input" FormName="change-password" OnValidSubmit="ChangePasswordAsync" method="post" class="account-form">
    <DataAnnotationsValidator />

    <div class="account-field">
        <label for="current-password">Contraseña actual</label>
        <input type="password" name="Input.OldPassword" id="current-password" autocomplete="current-password" required />
        <ValidationMessage For="() => Input.OldPassword" />
    </div>
    <div class="account-field">
        <label for="new-password">Contraseña nueva</label>
        <input type="password" name="Input.NewPassword" id="new-password" autocomplete="new-password" minlength="@AccountText.MinimumPasswordLength" maxlength="@AccountText.MaximumPasswordLength" aria-describedby="new-password-hint" required />
        <small id="new-password-hint">Usá al menos @AccountText.MinimumPasswordLength caracteres.</small>
        <ValidationMessage For="() => Input.NewPassword" />
    </div>
    <div class="account-field">
        <label for="confirm-password">Repetí la contraseña nueva</label>
        <input type="password" name="Input.ConfirmPassword" id="confirm-password" autocomplete="new-password" maxlength="@AccountText.MaximumPasswordLength" required />
        <ValidationMessage For="() => Input.ConfirmPassword" />
    </div>
    <button type="submit" class="account-button">Cambiar contraseña</button>
</EditForm>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangePasswordAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(HttpContext);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            errorMessage = AccountText.DescribeErrors(result);
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToWithStatus("Account/Manage/ChangePassword", "Actualizamos tu contraseña.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Ingresá tu contraseña actual.")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Elegí una contraseña nueva.")]
        [StringLength(AccountText.MaximumPasswordLength, MinimumLength = AccountText.MinimumPasswordLength, ErrorMessage = AccountText.PasswordLengthMessage)]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Repetí la contraseña nueva.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Las contraseñas tienen que coincidir.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
