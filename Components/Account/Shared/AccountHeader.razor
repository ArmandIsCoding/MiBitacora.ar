<header class="account-topbar">
    <div class="account-topbar-inner">
        <Brand Href="@(SignedIn ? "/bitacora" : "/")" />
        <nav aria-label="Cuenta" class="account-topbar-nav">
            @if (SignedIn)
            {
                <a href="bitacora">Ir a mi bitácora</a>
                <AuthorizeView Policy="@AdminAccess.Policy">
                    <Authorized>
                        <a href="admin">Administración</a>
                    </Authorized>
                </AuthorizeView>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="account-logout">Cerrar sesión</button>
                </form>
            }
            else
            {
                <a href="/">Volver al inicio</a>
            }
        </nav>
    </div>
</header>

@code {
    [Parameter]
    public bool SignedIn { get; set; }
}
