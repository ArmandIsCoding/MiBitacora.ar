@inherits LayoutComponentBase
@layout MiBitacora.Components.Layout.MainLayout

<AccountHeader />
<main class="account-access">
    <aside class="account-note">
        <svg class="account-note-icon" width="42" height="42" viewBox="0 0 42 42" fill="none" aria-hidden="true">
            <path d="M6 6h23a4 4 0 0 1 4 4v19H10a4 4 0 0 0-4 4V6Zm0 27a4 4 0 0 0 4 4h24M13 13h13m-13 6h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p class="account-kicker">Mi Bitácora</p>
        <p class="account-note-phrase">Un rato para vos.</p>
        <p>Un espacio para escribir lo que te pasa y volver a leerlo cuando quieras.</p>
    </aside>
    <div class="account-card">
        @Body
    </div>
</main>
