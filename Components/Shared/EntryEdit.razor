@using System.Security.Claims
@implements IAsyncDisposable
@inject IServiceProvider Services

<button type="button" class="icon-button entry-edit" aria-label="Editar entrada" title="Editar entrada"
        disabled="@(Busy || _saving || _opening || !RendererInfo.IsInteractive)" @onclick="OpenAsync"><Icon Name="pen" Size="17" /></button>
@if (!_editing && _error is not null) { <span class="entry-edit-error" role="alert">@_error</span> }
@if (_editing)
{
    <dialog class="journal-dialog entry-edit-dialog" @ref="_dialog" aria-labelledby="@TitleId" @onkeydown="OnKeyAsync">
        <div class="dialog-inner">
            <button type="button" class="icon-button dialog-close" aria-label="Cerrar editor" @onclick="Close" disabled="@_saving"><Icon Name="x" Size="21" /></button>
            <p class="eyebrow">TU ENTRADA</p>
            <h2 id="@TitleId">Editá lo que escribiste.</h2>
            <p>Si hay una devolución, se quitará al guardar para que puedas pedir una nueva.</p>
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label class="visually-hidden" for="@TextId">Texto de la entrada</label>
                <textarea id="@TextId" rows="8" maxlength="@JournalStore.MaxTextLength" @bind="_text" @bind:event="oninput" autofocus disabled="@_saving"></textarea>
                @if (_error is not null) { <p class="entry-error" role="alert">@_error</p> }
                <div class="dialog-actions">
                    <small>@_text.Length / @JournalStore.MaxTextLength</small>
                    <button type="button" class="btn btn-outline" @onclick="Close" disabled="@_saving">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@(!CanSave)">@(_saving ? "Guardando…" : "Guardar cambios")</button>
                </div>
            </form>
        </div>
    </dialog>
}

@code {
    [Parameter, EditorRequired] public JournalEntry Entry { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<JournalEntry> Updated { get; set; }
    private JournalEntry? _original;
    private string _text = "";
    private string? _error;
    private bool _editing, _saving, _opening, _disposed;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private readonly CancellationTokenSource _lifetime = new();
    private string TitleId => $"entry-edit-title-{Entry.Id:N}";
    private string TextId => $"entry-edit-text-{Entry.Id:N}";
    private IJournalStore Store => Services.GetRequiredService<IJournalStore>();
    private IJSRuntime Js => Services.GetRequiredService<IJSRuntime>();
    private AuthenticationStateProvider Auth => Services.GetRequiredService<AuthenticationStateProvider>();
    private bool CanSave => !Busy && !_saving && _original is not null && _text.Trim() != _original.Text.Trim()
        && (!string.IsNullOrWhiteSpace(_text) || _original.Attachments.Count > 0);
    private async Task<string> UserAsync() => (await Auth.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier)
        ?? throw new JournalInputException("Tu sesión terminó. Volvé a ingresar.");
    private async Task OpenAsync()
    {
        if (Busy || _saving || _opening) return;
        _opening = true;
        _error = null;
        try
        {
            _original = await Store.GetEntryAsync(await UserAsync(), Entry.Id, _lifetime.Token)
                ?? throw new JournalInputException("La entrada ya no está disponible.");
            _text = _original.Text;
            _editing = true;
        }
        catch (JournalInputException ex) { _error = ex.Message; }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex) { Log(ex); _error = "No pudimos abrir el editor. Volvé a intentarlo."; }
        finally { _opening = false; }
    }
    private async Task SaveAsync()
    {
        if (!CanSave || _original is null) return;
        _saving = true; _error = null;
        try
        {
            var updated = await Store.UpdateEntryAsync(await UserAsync(), _original.Id, _text, _lifetime.Token, _original.Text);
            _editing = false;
            await Updated.InvokeAsync(updated);
        }
        catch (JournalInputException ex) { _error = ex.Message; }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex) { Log(ex); _error = "No pudimos guardar los cambios. Tu texto sigue en el editor."; }
        finally { _saving = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_editing || _disposed) return;
        try
        {
            _module ??= await Js.InvokeAsync<IJSObjectReference>("import", _lifetime.Token, "./" + Assets["journal.js"]);
            if (_editing) await _module.InvokeVoidAsync("showDialog", _lifetime.Token, _dialog);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_disposed) { }
    }
    private void Close() { if (!_saving) { _editing = false; _error = null; } }
    private void OnKeyAsync(KeyboardEventArgs args) { if (args.Key == "Escape") Close(); }
    private void Log(Exception ex) => Services.GetRequiredService<ILogger<EntryEdit>>()
        .LogWarning("No se pudo editar una entrada ({ErrorType}).", ex.GetType().Name);
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel();
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _lifetime.Dispose();
    }
}
