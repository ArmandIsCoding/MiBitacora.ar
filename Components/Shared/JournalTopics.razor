@implements IAsyncDisposable
@inject JournalTopicService Topics
@inject JournalReportService Reports
@inject IJournalTopicAnalyzer Analyzer
@inject TimeZoneInfo TimeZone
@inject ILogger<JournalTopics> Logger

<div class="topic-workspace">
    <div class="topic-toolbar">
        <p>Un informe completo de tu recorrido, para leer con calma y llevar a terapia.</p>
        <button type="button" class="btn btn-primary" @onclick="GenerateAsync" disabled="@(_busy || _loading || !Analyzer.IsConfigured || !RendererInfo.IsInteractive)">
            <Icon Name="spark" Size="18" /> @(_state.Snapshot is null ? "Generar devolución" : "Actualizar devolución")
        </button>
    </div>
    @if (Analyzer.UsesExternalProvider)
    {
        <p class="topic-scope">Al generar o actualizar, los textos se envían a OpenAI para preparar la devolución. <a href="privacidad">Ver privacidad</a>.</p>
    }
    <p class="topic-scope">Integra los textos de todo tu cuaderno, documentos, notitas y contexto personal. Distingue lo registrado de las hipótesis y propuestas para terapia. Las fotos se analizan en la conversación.</p>
    @if (!Analyzer.IsConfigured)
    {
        <p class="journal-alert" role="status">La IA está desactivada. Podés consultar la última devolución guardada.</p>
    }
    @if (_error is not null) { <p class="journal-alert" role="alert">@_error</p> }
    @if (_message is not null) { <p class="journal-notice" role="status">@_message</p> }
    @if (_loading) { <p class="organizing" role="status"><span class="spinner"></span> Abriendo tu informe…</p> }
    @if (_busy)
    {
        <div class="topic-progress">
            <p class="organizing" role="status" aria-live="polite"><span class="spinner"></span> @_progress</p>
            <p>Puede llevar varios minutos. Podés recorrer el cuaderno; mantené la página abierta hasta que termine.</p>
            <button type="button" class="quiet-action" @onclick="Cancel">Cancelar actualización</button>
        </div>
    }
    @if (_state.Snapshot is { Report: not null } reportSnapshot)
    {
        <div class="report-actions"><span>Actualizado el @Date(reportSnapshot.GeneratedUtc), @Local(reportSnapshot.GeneratedUtc).ToString("HH:mm")</span><a class="btn btn-outline" href="/informe" target="_blank" rel="noopener"><Icon Name="print" Size="17" /> Imprimir / guardar PDF</a></div>
        @if (_state.IsOutdated) { <p class="journal-notice">Hay cambios en tu cuaderno. «Actualizar devolución» prepara un informe nuevo con ellos.</p> }
        <TherapyReportView Snapshot="reportSnapshot" />
    }
    else if (_state.Snapshot is { } snapshot)
    {
        <p class="journal-notice">Ya podés preparar un informe integrado para terapia con «Actualizar devolución». Tu versión anterior sigue disponible mientras tanto.</p>
        <details class="legacy-topics"><summary>Ver la devolución anterior por temas</summary>
        <div class="topic-summary">
            <p><strong>@snapshot.Topics.Count @(snapshot.Topics.Count == 1 ? "tema" : "temas")</strong> · Actualizado el @Date(snapshot.GeneratedUtc), @Local(snapshot.GeneratedUtc).ToString("HH:mm")</p>
            <p>Texto disponible en @snapshot.TextEntryCount de @snapshot.EntryCount entradas · @snapshot.DocumentCount @(snapshot.DocumentCount == 1 ? "documento" : "documentos") con texto.</p>
            @if (snapshot.NoteCount > 0 || snapshot.HasPersonalContext)
            {
                <p>Contexto adicional: @snapshot.NoteCount @(snapshot.NoteCount == 1 ? "notita" : "notitas")@(snapshot.HasPersonalContext ? " y tu contexto personal del perfil" : "").</p>
            }
            @if (snapshot.UnreadAttachmentCount > 0) { <p>@snapshot.UnreadAttachmentCount adjuntos sin texto disponible no participaron de este análisis.</p> }
            @if (_state.IsOutdated) { <p class="topic-outdated"><Icon Name="info" Size="16" /> Hay cambios en tu cuaderno o en el contexto del análisis. Actualizá la devolución para incluirlos.</p> }
        </div>
        @if (snapshot.AdditionalContext is { Count: > 0 } additionalContext)
        {
            <details class="topic-evidence">
                <summary>Ver contexto adicional considerado</summary>
                <p class="topic-scope">Estos fragmentos vienen de tus notitas y del perfil. Se consideraron como contexto del conjunto, sin asignarlos a una entrada ni suponer que explican todos los temas.</p>
                @foreach (var context in additionalContext)
                {
                    <figure><figcaption>@context.Label@if (context.CreatedUtc is { } date) { <span> · @Date(date)</span> }</figcaption><blockquote class="preserved-text">@context.Excerpt</blockquote></figure>
                }
            </details>
        }
        @if (snapshot.Topics.Count == 0)
        {
            <div class="blank-journal blank-small"><h2>Todavía no surgieron temas claros.</h2><p>Podés seguir escribiendo y volver a intentarlo más adelante.</p></div>
        }
        else
        {
            <nav class="topic-index" aria-label="Temas de tu devolución">
                @foreach (var topic in snapshot.Topics) { <a href="@($"/bitacora?seccion=temas#tema-{topic.Id}")">@topic.Title</a> }
            </nav>
            <p class="topic-scope">Una lectura posible, para revisar y completar con tu mirada.</p>
            <div class="topic-list">
                @foreach (var topic in snapshot.Topics)
                {
                    var entryCount = topic.Evidence.Where(e => e.EntryId.HasValue).Select(e => e.EntryId).Distinct().Count();
                    <article class="topic-card" id="@($"tema-{topic.Id}")" @key="topic.Id">
                        <header><span class="eyebrow"><Icon Name="spark" Size="15" /> UN TEMA DE TU CUADERNO</span><h2>@topic.Title</h2><p>@(entryCount > 0 ? $"{entryCount} {(entryCount == 1 ? "entrada relacionada" : "entradas relacionadas")}" : "Desde tus notitas y tu contexto personal")</p></header>
                        <p class="preserved-text">@topic.Overview</p>
                        @if (topic.Questions.Count > 0)
                        {
                            <div class="topic-questions"><h3>Para seguir pensando</h3><ul>@foreach (var question in topic.Questions) { <li>@question</li> }</ul></div>
                        }
                        <details class="topic-evidence">
                            <summary>Ver fragmentos de apoyo (@topic.Evidence.Count)</summary>
                            @foreach (var evidence in topic.Evidence)
                            {
                                <figure>
                                    <figcaption>@evidence.Label@if (evidence.CreatedUtc is { } date) { <span> · <time datetime="@date.ToString("O")">@Date(date)</time></span> }</figcaption>
                                    <blockquote class="preserved-text">@evidence.Excerpt</blockquote>
                                    @if (evidence.EntryId is { } entryId)
                                    {
                                        <a class="evidence-entry-link" href="@($"/entrada/{entryId}?tema={Uri.EscapeDataString(topic.Id)}")" target="_blank" rel="noopener">Abrir entrada completa <Icon Name="arrow" Size="15" /><span class="visually-hidden"> (en otra pestaña)</span></a>
                                    }
                                </figure>
                            }
                        </details>
                    </article>
                }
            </div>
        }
        </details>
    }
    else if (!_loading && !_busy)
    {
        <div class="blank-journal blank-small topic-empty"><span class="empty-note-icon sage"><Icon Name="book" Size="40" /></span><h2>Tu recorrido, con perspectiva.</h2><p>Prepará un informe con tu evolución, emociones, vínculos, recursos y asuntos para trabajar en terapia. Incluye fragmentos originales para revisar cada lectura.</p><p>Se genera con @Analyzer.ProviderName.</p></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter] public bool Active { get; set; }
    [Parameter] public int ContextRevision { get; set; }
    private JournalTopicState _state = new(null, false);
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _generation;
    private bool _wasActive, _busy, _loading, _disposed;
    private int _seenContextRevision = -1;
    private string? _error, _message;
    private string _progress = "Preparando el cuaderno…";

    protected override async Task OnParametersSetAsync()
    {
        var opening = Active && !_wasActive;
        _wasActive = Active;
        if (!Active || (!opening && ContextRevision == _seenContextRevision) || _busy) return;
        _seenContextRevision = ContextRevision;
        _loading = true;
        try { _state = await Topics.GetAsync(UserId, _lifetime.Token); _error = null; }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex) { _state = new(null, false); Logger.LogWarning(ex, "No se pudo leer la devolución por temas."); _error = "No pudimos abrir la devolución. Volvé a entrar a esta pestaña para reintentar."; }
        finally { _loading = false; }
    }

    private async Task GenerateAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = _message = null;
        _progress = "Preparando el cuaderno…";
        using var generation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _generation = generation;
        try
        {
            var progress = new TopicProgress(value =>
            {
                if (!_disposed) _ = InvokeAsync(() => { _progress = value; StateHasChanged(); });
            });
            var snapshot = await Reports.GenerateAsync(UserId, progress, generation.Token);
            _state = new(snapshot, false);
            _message = "Tu informe para terapia quedó guardado.";
        }
        catch (OperationCanceledException) { _message = "Actualización cancelada. La última devolución guardada se conserva."; }
        catch (JournalInputException ex) { _error = ex.Message; }
        catch (JournalReflectionException ex) { _error = ex.Message; }
        catch (Exception ex) { Logger.LogWarning(ex, "No se pudo generar la devolución por temas."); _error = "No pudimos guardar la devolución. Podés reintentar; tus entradas siguen guardadas."; }
        finally
        {
            _generation = null;
            _busy = false;
            if (!_disposed)
            {
                try { _state = await Topics.GetAsync(UserId, _lifetime.Token); }
                catch { _state = new(null, false); }
            }
        }
    }

    private void Cancel() => _generation?.Cancel();
    private DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZone);
    private string Date(DateTime utc) => Local(utc).ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
    public async ValueTask DisposeAsync() { _disposed = true; await _lifetime.CancelAsync(); _lifetime.Dispose(); }
    private sealed class TopicProgress(Action<string> report) : IProgress<string> { public void Report(string value) => report(value); }
}
