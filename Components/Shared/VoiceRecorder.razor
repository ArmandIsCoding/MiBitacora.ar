@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="voice-recorder" @ref="_root" aria-label="Mensaje de voz">
    <header><span><Icon Name="mic" Size="18" /> Mensaje de voz</span><button type="button" class="icon-button" aria-label="Descartar y cerrar audio" title="Descartar y cerrar" @onclick="CloseAsync" disabled="@_adding"><Icon Name="x" Size="18" /></button></header>
    @if (_recording)
    {
        <div class="voice-recording"><span class="recording-dot"></span><span>Grabando</span><output class="voice-time" aria-label="Duración de la grabación">0:00</output><button type="button" class="voice-stop" @onclick="StopAsync" aria-label="Detener grabación"><Icon Name="stop" Size="18" /> Detener</button></div>
    }
    else if (_clip is not null)
    {
        <audio class="voice-preview" src="@_clip.Url" controls preload="metadata" aria-label="Escuchar grabación antes de adjuntar"></audio>
        <div class="voice-options"><button type="button" class="quiet-action" @onclick="ResetAsync" disabled="@_adding"><Icon Name="trash" Size="17" /> Descartar</button><button type="button" class="btn btn-primary" @onclick="AttachAsync" disabled="@_adding">@(_adding ? "Adjuntando…" : "Usar audio") <Icon Name="check" Size="16" /></button></div>
    }
    else
    {
        <div class="voice-options">
            <button type="button" class="btn btn-primary" @onclick="StartAsync" disabled="@(_starting || _adding || !RendererInfo.IsInteractive)"><Icon Name="mic" Size="18" /> @(_starting ? "Abriendo micrófono…" : "Grabar")</button>
            <InputFile id="@_pickerId" class="visually-hidden file-input" accept="audio/*,.m4a,.mp3,.wav,.ogg,.flac,.weba,.webm" OnChange="PickAudioAsync" disabled="@(_starting || _adding)" />
            <label for="@_pickerId" class="composer-tool"><Icon Name="paperclip" Size="18" /> Subir audio</label>
        </div>
        <p class="voice-hint">Grabá con el micrófono o elegí un archivo de hasta 8 MB. Se transcribe al enviar.</p>
    }
    @if (_error is not null) { <p class="voice-error" role="alert">@_error</p> }
</section>

@code {
    [Parameter] public EventCallback<PendingAttachment> AttachmentReady { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    private readonly string _pickerId = "audio-picker-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource _lifetime = new();
    private ElementReference _root;
    private IJSObjectReference? _module, _recorder;
    private DotNetObjectReference<VoiceRecorder>? _reference;
    private VoiceClip? _clip;
    private bool _recording, _starting, _adding, _disposed;
    private string? _error;

    private async Task<IJSObjectReference> RecorderAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["voice-recorder.js"]);
        _reference ??= DotNetObjectReference.Create(this);
        return _recorder ??= await _module.InvokeAsync<IJSObjectReference>("create", _root, _reference, JournalStore.MaxFileBytes);
    }
    private async Task StartAsync()
    {
        if (_starting || _recording || _adding) return;
        _starting = true; _error = null;
        try
        {
            var error = await (await RecorderAsync()).InvokeAsync<string?>("start");
            if (!_disposed) { _error = error; _recording = error is null; }
        }
        catch (JSException) { _error = "No se pudo abrir el micrófono. Podés subir un audio desde tus archivos."; }
        finally { _starting = false; }
    }
    private async Task StopAsync()
    {
        if (_recorder is not null) await _recorder.InvokeVoidAsync("stop");
    }
    [JSInvokable] public Task RecordingReady(VoiceClip clip)
    {
        if (_disposed) return Task.CompletedTask;
        _recording = false; _clip = clip;
        return InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public Task RecordingFailed(string message)
    {
        if (_disposed) return Task.CompletedTask;
        _recording = false; _error = message;
        return InvokeAsync(StateHasChanged);
    }
    private async Task AttachAsync()
    {
        if (_clip is null || _recorder is null || _adding) return;
        _adding = true; _error = null;
        try
        {
            await using var reference = await _recorder.InvokeAsync<IJSStreamReference>("read");
            await using var stream = await reference.OpenReadStreamAsync(JournalStore.MaxFileBytes, _lifetime.Token);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer, _lifetime.Token);
            await AttachmentReady.InvokeAsync(new PendingAttachment(_clip.FileName, buffer.ToArray(), true));
        }
        catch (JournalInputException ex) { _error = ex.Message; }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception) { _error = "No pudimos adjuntar el audio. Tu grabación sigue acá para volver a intentarlo."; }
        finally { _adding = false; }
    }
    private async Task PickAudioAsync(InputFileChangeEventArgs args)
    {
        if (_adding || _recording) return;
        _adding = true; _error = null;
        try
        {
            var file = args.File;
            if (file.Size is <= 0 or > JournalStore.MaxFileBytes) throw new JournalInputException("El audio puede pesar hasta 8 MB.");
            await using var stream = file.OpenReadStream(JournalStore.MaxFileBytes, _lifetime.Token);
            using var buffer = new MemoryStream(); await stream.CopyToAsync(buffer, _lifetime.Token);
            var bytes = buffer.ToArray();
            var analysis = AttachmentExtractor.Analyze(AttachmentExtractor.CleanFileName(file.Name), bytes, _lifetime.Token);
            if (!AttachmentPresentation.IsInlineAudio(analysis.ContentType)) throw new JournalInputException("No reconocimos un audio en ese archivo. Probá con M4A, MP3, WAV, OGG, FLAC o WebM de audio.");
            await AttachmentReady.InvokeAsync(new PendingAttachment(file.Name, bytes));
        }
        catch (JournalInputException ex) { _error = ex.Message; }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception) { _error = "No se pudo leer el audio. Probá otra vez."; }
        finally { _adding = false; }
    }
    private async Task ResetAsync()
    {
        if (_recorder is not null) await _recorder.InvokeVoidAsync("reset");
        _clip = null; _error = null;
    }
    private async Task CloseAsync()
    {
        if (_recorder is not null) await _recorder.InvokeVoidAsync("dispose");
        await Closed.InvokeAsync();
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; await _lifetime.CancelAsync();
        try
        {
            if (_recorder is not null) { await _recorder.InvokeVoidAsync("dispose"); await _recorder.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        _reference?.Dispose(); _lifetime.Dispose();
    }
    public sealed record VoiceClip(string FileName, string Url, long Size);
}
