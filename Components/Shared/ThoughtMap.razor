@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="thought-map @(Demo ? "is-demo" : "")" @ref="_host" aria-label="Mapa interactivo de ideas">
    <div class="thought-toolbar">
        <label class="thought-search"><Icon Name="zoom" Size="17" /><span class="visually-hidden">Buscar en el mapa</span><input type="search" placeholder="Buscá una idea…" data-map-search maxlength="100" autocomplete="off" /></label>
        <div class="thought-view-actions" role="group" aria-label="Vista del mapa">
            <button type="button" data-map-action="out" aria-label="Alejar mapa">−</button>
            <button type="button" data-map-action="in" aria-label="Acercar mapa">+</button>
            <button type="button" data-map-action="fit" title="Ver todo el mapa"><Icon Name="expand" Size="18" /><span>Ver todo</span></button>
        </div>
    </div>
    <div class="thought-explorer">
        <div class="thought-stage" data-map-stage tabindex="0" aria-label="Constelación de ideas. Arrastrá para recorrer; usá los botones para acercar. Con teclado: flechas para recorrer, más y menos para zoom, Inicio para ver todo, Escape para salir de una rama.">
            <svg data-map-svg role="group" aria-label="Entradas, temas, preguntas y sus conexiones"></svg>
            <div class="thought-stage-label" aria-hidden="true"><span class="thought-orbit-mark">✧</span> @if (Demo) { <span>UN RECORRIDO POSIBLE</span> } else { <span>TU UNIVERSO DE IDEAS</span> }</div>
            <div class="thought-map-hint" data-map-hint>Arrastrá para explorar · elegí un punto para seguir su historia</div>
            <p class="thought-no-results" data-map-empty hidden>No encontramos esa idea en este mapa. Probá con otra palabra.</p>
        </div>
        <aside class="thought-detail" aria-label="La historia de esta conexión">
            <div data-map-welcome>
                <span class="thought-detail-kicker">TODO EMPIEZA CON UNA IDEA</span>
                <h3>Seguí el hilo<br /><em>de lo que te pasa.</em></h3>
                <p>Acercate a un punto. Descubrí de dónde viene una pregunta, qué entradas conectó Brisa y cómo seguiste pensando.</p>
                <div class="thought-detail-orbit" aria-hidden="true"><i></i><i></i><i></i><span>✧</span></div>
                <p class="thought-detail-note">Tus palabras son el punto de partida. Los temas de Brisa son posibilidades para explorar con tu terapeuta.</p>
            </div>
            <div data-map-detail hidden>
                <div class="thought-detail-heading"><span class="thought-detail-kicker" data-map-kind></span><button type="button" class="thought-close" data-map-action="clear" aria-label="Cerrar selección">×</button></div>
                <h3 data-map-title tabindex="-1"></h3>
                <p class="thought-detail-meta" data-map-meta></p>
                <p class="thought-detail-text" data-map-text></p>
                <a class="thought-source" data-map-source hidden>Abrir original <Icon Name="arrow" Size="16" /></a>
                <button type="button" class="thought-branch" data-map-action="branch" aria-pressed="false"><Icon Name="graph" Size="17" /> Explorar esta rama</button>
                <h4>Conexiones <span data-map-degree></span></h4>
                <ul class="thought-connections" data-map-connections></ul>
            </div>
        </aside>
    </div>
    <div class="thought-map-footer">
        <div class="thought-legend" aria-label="Qué representa cada punto"><span class="is-entry">Tus entradas</span><span class="is-theme">Temas de Brisa</span><span class="is-question">Preguntas</span><span class="is-note">Notitas y contexto</span></div>
        <span class="thought-visible" data-map-count role="status" aria-live="polite">Preparando conexiones…</span>
    </div>
    @if (_failed) { <p class="thought-runtime-error" role="status">No pudimos abrir la vista interactiva. @if (Demo) { <span>Podés seguir conociendo los planes y empezar tu propio recorrido.</span> } else { <span>Podés recorrer las entradas en la lista de abajo.</span> }</p> }
</section>

@code {
    [Parameter, EditorRequired] public ThoughtMapData Data { get; set; } = default!;
    [Parameter] public bool Demo { get; set; }
    private ElementReference _host;
    private IJSObjectReference? _module, _map;
    private ThoughtMapData? _rendered;
    private bool _disposed;
    private bool _failed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || ReferenceEquals(Data, _rendered)) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./thought-map.js");
            if (_disposed) return;
            if (_map is not null) { await _map.InvokeVoidAsync("dispose"); await _map.DisposeAsync(); }
            _map = await _module.InvokeAsync<IJSObjectReference>("create", _host, Data, Demo);
            _rendered = Data;
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (JSException) { _rendered = Data; _failed = true; StateHasChanged(); }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_map is not null) { await _map.InvokeVoidAsync("dispose"); await _map.DisposeAsync(); }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
