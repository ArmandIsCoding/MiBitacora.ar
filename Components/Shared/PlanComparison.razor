@inject Microsoft.Extensions.Options.IOptions<SubscriptionOptions> Plans

<div class="plan-comparison">
    <article class="plan-card" aria-label="Plan Gratuito">
        <p class="plan-kicker">PARA TU DÍA A DÍA</p>
        @if (HeadingLevel == 2) { <h2 class="plan-name">Gratuito</h2> } else { <h3 class="plan-name">Gratuito</h3> }
        <p class="plan-price"><strong>$0</strong><span>Gratis por siempre · sin tarjeta</span></p>
        <p class="plan-description">Un espacio para escribir y reflexionar con Brisa, a tu ritmo.</p>
        <ul role="list" class="plan-features">
            <li><Icon Name="check" Size="18" /><span>Tus diarios, fotos, audios, videos y documentos.</span></li>
            <li><Icon Name="check" Size="18" /><span>Conversaciones con Brisa e IA local.</span></li>
            <li><Icon Name="check" Size="18" /><span>Notitas, calendario e informes para tu terapia.</span></li>
            <li><Icon Name="check" Size="18" /><span>Descarga y exportación de tus textos y archivos.</span></li>
        </ul>
        <div class="plan-actions">
            <div class="plan-payment"><Icon Name="leaf" Size="26" /><span>Sin tarjeta. Sin período de prueba.</span></div>
            <AuthorizeView>
                <Authorized><a class="btn btn-primary plan-action" href="/bitacora">Ir a mi cuaderno <Icon Name="arrow" Size="17" /></a></Authorized>
                <NotAuthorized><a class="btn btn-primary plan-action" href="/Account/Register">Empezar gratis <Icon Name="arrow" Size="17" /></a></NotAuthorized>
            </AuthorizeView>
            <p class="plan-commitment">Gratis por siempre. Sin vencimiento ni obligación de contratar Profundo.</p>
        </div>
    </article>
    <article class="plan-card" aria-label="Plan Profundo">
        <p class="plan-kicker">PARA UNA MIRADA MÁS PROFUNDA</p>
        @if (HeadingLevel == 2) { <h2 class="plan-name">Profundo</h2> } else { <h3 class="plan-name">Profundo</h3> }
        <p class="plan-price"><strong>$@MonthlyPrice</strong><span>por mes · precio final en pesos argentinos</span></p>
        <p class="plan-description">Para profundizar tus conversaciones y preparar con más detalle tu próxima sesión.</p>
        <ul role="list" class="plan-features">
            <li><Icon Name="check" Size="18" /><span>Todo lo que incluye el plan Gratuito.</span></li>
            <li><Icon Name="check" Size="18" /><span>Conversaciones e informes con OpenAI.</span></li>
            <li><Icon Name="check" Size="18" /><span>@Plans.Value.MonthlyCredits créditos por período mensual, con consumo visible.</span></li>
            <li><Icon Name="check" Size="18" /><span>Aviso al llegar al 80% y opción de alternar con IA local.</span></li>
        </ul>
        <div class="plan-actions">
            <div class="plan-payment"><span>Pagás en pesos con</span><img src="@Assets["brand/mercado-pago.svg"]" width="164" height="66" alt="Mercado Pago" loading="lazy" /></div>
            <AuthorizeView>
                <Authorized><a class="btn btn-primary plan-action" href="/Account/Manage/Subscription">Ver mi plan <Icon Name="arrow" Size="17" /></a></Authorized>
                <NotAuthorized><a class="btn btn-primary plan-action" href="/Account/Manage/Subscription">Elegir Profundo <Icon Name="arrow" Size="17" /></a></NotAuthorized>
            </AuthorizeView>
            <p class="plan-commitment">Renovación mensual automática. Cancelás cuando quieras desde Mi plan y seguís gratis por siempre.</p>
        </div>
    </article>
</div>

@code {
    [Parameter] public int HeadingLevel { get; set; } = 3;
    private string MonthlyPrice => Plans.Value.MonthlyPriceArs.ToString(Plans.Value.MonthlyPriceArs == decimal.Truncate(Plans.Value.MonthlyPriceArs) ? "N0" : "N2", System.Globalization.CultureInfo.GetCultureInfo("es-AR"));
}
