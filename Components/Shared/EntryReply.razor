@using System.Security.Claims
@implements IAsyncDisposable
@inject IServiceProvider Services

<div class="entry-reply" id="@($"reply-{Entry.Id:N}")" @ref="_replyHost">
@if (_current.Reflection is { } reflection)
{
    <div class="reply-ready" @key="reflection.GeneratedUtc">
    <ReflectionCard Reflection="reflection" Selected="_current.ForSession" Busy="@(Busy || _generating)"
                    SaveAsNote="SaveAsNote" ToggleSession="ToggleSession" Regenerating="_generating"
                    Regenerate="@(CanRegenerate ? EventCallback.Factory.Create(this, RegenerateAsync) : default)" JustResponded="FreshResponse" />
    </div>
}
@if (_generating) { <ReplyPending Message="@_progress" OfferUpgrade="_offerUpgrade" Activity="_activity" /> }
@if (_error is not null) { <p class="entry-error" role="alert">@_error La respuesta anterior se conserva.</p> }
</div>

@code {
    [Parameter, EditorRequired] public JournalEntry Entry { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanRegenerate { get; set; } = true;
    [Parameter] public EventCallback<JournalEntry> Updated { get; set; }
    [Parameter] public EventCallback SaveAsNote { get; set; }
    [Parameter] public EventCallback ToggleSession { get; set; }
    [Parameter] public bool JustResponded { get; set; }
    [Parameter] public EventCallback<BrisaActivity> ActivityChanged { get; set; }
    private JournalEntry _current = default!;
    private JournalEntry? _previous;
    private bool _generating, _disposed, _offerUpgrade, _revealReply;
    private ElementReference _replyHost;
    private IJSObjectReference? _module;
    private string? _error;
    private string _progress = "Brisa está preparando una nueva mirada…";
    private readonly CancellationTokenSource _lifetime = new();
    private BrisaActivity _activity = BrisaActivity.Reading;
    private bool _respondedHere;
    private bool FreshResponse => (JustResponded || _respondedHere) && !_generating &&
        _current.Reflection?.GeneratedUtc is { } generated && DateTime.UtcNow - generated < TimeSpan.FromSeconds(6);
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_previous, Entry)) { _previous = Entry; _current = Entry; }
    }
    private async Task RegenerateAsync()
    {
        if (_generating || Busy || !CanRegenerate) return;
        _generating = true; _error = null; _respondedHere = false;
        _activity = BrisaActivity.Reading;
        _progress = "Brisa está leyendo lo que le contaste…";
        var completed = false;
        string? userId = null;
        try
        {
            await ActivityChanged.InvokeAsync(BrisaActivity.Reading);
            var auth = Services.GetRequiredService<AuthenticationStateProvider>();
            var id = (await auth.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier)
                ?? throw new JournalInputException("Tu sesión terminó. Volvé a ingresar.");
            userId = id;
            var reflector = Services.GetRequiredService<IJournalReflector>();
            if (reflector is AccountJournalService accountAi) await accountAi.SelectAccountAsync(id, _lifetime.Token);
            _offerUpgrade = !reflector.HasPremiumAccess;
            var conversation = Services.GetRequiredService<JournalConversationService>();
            if (!conversation.IsConfigured) throw new JournalReflectionException("Brisa no puede responder en esta instalación por el momento.");
            _current = await conversation.GenerateAsync(id, Entry.Id, true, new ReplyProgress(message =>
            {
                if (!_disposed) _ = InvokeAsync(() => { _progress = message; StateHasChanged(); });
            }), _lifetime.Token, new ActivityProgress(activity =>
            {
                if (!_disposed) _ = InvokeAsync(async () =>
                {
                    if (!_generating || _disposed) return;
                    _activity = activity;
                    await ActivityChanged.InvokeAsync(activity);
                    StateHasChanged();
                });
            }));
            await Updated.InvokeAsync(_current);
            completed = true;
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex) when (ex is JournalReflectionException or JournalInputException) { _error = ex.Message; }
        catch (Exception) { _error = "No se pudo completar la nueva respuesta. Podés volver a intentarlo."; }
        finally
        {
            // A transcript may have finished even when generating the response failed.
            if (!_disposed && _error is not null && userId is not null)
            {
                try
                {
                    var entry = await Services.GetRequiredService<IJournalStore>().GetEntryAsync(userId, Entry.Id, _lifetime.Token);
                    if (entry is not null) { _current = entry; await Updated.InvokeAsync(entry); }
                }
                catch (Exception) { /* Keep the last visible response if refreshing is also unavailable. */ }
            }
            _generating = false;
            _revealReply = completed && !_disposed;
            _respondedHere = completed;
            if (!_disposed) await ActivityChanged.InvokeAsync(completed ? BrisaActivity.Responding : BrisaActivity.Idle);
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_revealReply || _disposed) return;
        _revealReply = false;
        try
        {
            _module ??= await Services.GetRequiredService<IJSRuntime>().InvokeAsync<IJSObjectReference>("import", _lifetime.Token, "./" + Assets["journal.js"]);
            await _module.InvokeVoidAsync("centerReply", _lifetime.Token, _replyHost);
        }
        catch (JSException) { }
        catch (OperationCanceledException) when (_disposed) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel();
        if (_generating && ActivityChanged.HasDelegate)
        {
            try { await ActivityChanged.InvokeAsync(BrisaActivity.Idle); }
            catch (ObjectDisposedException) { }
        }
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _lifetime.Dispose();
    }
    private sealed class ReplyProgress(Action<string> callback) : IProgress<string> { public void Report(string message) => callback(message); }
    private sealed class ActivityProgress(Action<BrisaActivity> callback) : IProgress<BrisaActivity> { public void Report(BrisaActivity activity) => callback(activity); }
}
