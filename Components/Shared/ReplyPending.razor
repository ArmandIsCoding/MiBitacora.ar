<section class="reply-pending" aria-label="Brisa está pensando su respuesta">
    <div class="pending-heading" aria-hidden="true">
        <BrisaPortrait />
        <span class="brisa-reply-byline"><strong>Brisa</strong><small>Un momento para pensar con vos</small></span>
        <span class="brisa-thinking"><i></i><i></i><i></i></span>
    </div>
    <p class="pending-message" role="status" aria-atomic="true">@Message</p>
    <p class="pending-hint">Podés seguir leyendo esta conversación. Te llevaremos a la devolución cuando esté lista.</p>
    <div class="pending-lines" aria-hidden="true">
        <span></span><span></span><span></span>
    </div>
    @if (OfferUpgrade)
    {
        <div class="pending-upgrade">
            <p>Brisa puede necesitar un poco más de tiempo en el plan gratuito. Con el Plan Profundo podés explorar respuestas más completas y profundas y, por lo general, más rápidas.</p>
            <a href="/Account/Manage/Subscription" target="_blank" rel="noopener noreferrer">Conocer el Plan Profundo <Icon Name="arrow" Size="15" /></a>
        </div>
    }
</section>

@code {
    [Parameter] public string Message { get; set; } = "Brisa está pensando en lo que le contaste…";
    [Parameter] public bool OfferUpgrade { get; set; }
}
