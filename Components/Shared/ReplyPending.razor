<section class="reply-pending" aria-label="Respuesta en preparación">
    <div class="pending-heading" aria-hidden="true">
        <span class="reflection-mark"><Icon Name="spark" Size="19" /></span>
        <span class="eyebrow">MI BITÁCORA · IA</span>
    </div>
    <p class="pending-message" role="status" aria-atomic="true">@Message</p>
    <p class="pending-hint">Podés seguir leyendo esta conversación. Te llevaremos a la devolución cuando esté lista.</p>
    <div class="pending-lines" aria-hidden="true">
        <span></span><span></span><span></span>
    </div>
    @if (OfferUpgrade)
    {
        <div class="pending-upgrade">
            <p>La IA del plan gratuito puede tardar un poco. Con el Plan Profundo accedés a respuestas más completas y profundas y, por lo general, más rápidas.</p>
            <a href="/Account/Manage/Subscription" target="_blank" rel="noopener noreferrer">Conocer el Plan Profundo <Icon Name="arrow" Size="15" /></a>
        </div>
    }
</section>

@code {
    [Parameter] public string Message { get; set; } = "Mi Bitácora está preparando una respuesta…";
    [Parameter] public bool OfferUpgrade { get; set; }
}
