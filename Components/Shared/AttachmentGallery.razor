@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="attachment-list @(Compact ? "attachment-list-compact" : "")" aria-label="Archivos adjuntos">
    @foreach (var file in Files)
    {
        <button type="button" class="attachment-card attachment-open @(AttachmentPresentation.Kind(file) == AttachmentViewKind.Image ? "attachment-image" : "")"
                @key="file.Id" @onclick="() => Open(file.Id)" disabled="@(!RendererInfo.IsInteractive)"
                aria-label="@($"{AttachmentPresentation.Action(file)}: {file.FileName}")" aria-haspopup="dialog">
            @if (!Compact && AttachmentPresentation.Kind(file) == AttachmentViewKind.Image)
            {
                <img src="@PreviewUrl(file)" alt="" loading="lazy" />
            }
            <span class="attachment-caption">
                <span class="attachment-file-icon"><Icon Name="@AttachmentPresentation.Icon(file)" Size="20" /></span>
                <span class="attachment-label"><strong>@file.FileName</strong><small>@AttachmentPresentation.Action(file) · @SizeLabel(file.Size)</small></span>
                <Icon Name="@(AttachmentPresentation.Kind(file) is AttachmentViewKind.Audio or AttachmentViewKind.Video ? "play" : "expand")" Size="18" />
            </span>
        </button>
    }
</div>
@foreach (var audio in Files.Where(JournalAudio.IsAudio))
{
    <AudioTranscript File="audio" Compact="Compact" @key="audio.Id" />
}

@if (Current is { } active)
{
    var kind = AttachmentPresentation.Kind(active);
    <dialog class="attachment-viewer" @ref="_dialog" aria-labelledby="@_titleId">
        <div class="attachment-viewer-layout">
            <header class="attachment-viewer-header">
                <span class="attachment-viewer-count" aria-live="polite">@(CurrentIndex + 1) / @Files.Count</span>
                <h2 id="@_titleId">@active.FileName</h2>
                @if (kind == AttachmentViewKind.Image && !_failed)
                {
                    <button type="button" class="viewer-control" @onclick="() => _zoomed = !_zoomed" aria-label="@(_zoomed ? "Ajustar foto a la pantalla" : "Ampliar foto")" title="@(_zoomed ? "Ajustar foto" : "Ampliar foto")" aria-pressed="@_zoomed"><Icon Name="@(_zoomed ? "shrink" : "zoom")" Size="22" /></button>
                }
                <button type="button" class="viewer-control" @onclick="Close" aria-label="Cerrar visor" title="Cerrar visor" autofocus><Icon Name="x" Size="25" /></button>
            </header>
            <div class="attachment-viewer-stage @(_zoomed ? "is-zoomed" : "")" @key="active.Id">
                @if (_failed)
                {
                    <div class="attachment-viewer-empty" role="status"><Icon Name="info" Size="36" /><h3>No pudimos abrir este archivo.</h3><p>Puede que este navegador no admita su formato o que tu sesión haya terminado. El original sigue disponible abajo.</p></div>
                }
                else if (kind == AttachmentViewKind.Image)
                {
                    <img class="gallery-photo" src="@PreviewUrl(active)" alt="@active.FileName" @onerror="() => MediaFailed(active.Id)" />
                }
                else if (kind == AttachmentViewKind.Audio)
                {
                    <div class="attachment-audio"><span class="audio-art"><Icon Name="audio" Size="64" /></span><p>Un momento para escuchar.</p><audio controls preload="metadata" src="@PreviewUrl(active)" @onerror="() => MediaFailed(active.Id)">Tu navegador no admite este reproductor.</audio><AudioTranscript File="active" Compact="true" /></div>
                }
                else if (kind == AttachmentViewKind.Video)
                {
                    <video controls playsinline preload="metadata" src="@PreviewUrl(active)" aria-label="@active.FileName" @onerror="() => MediaFailed(active.Id)">Tu navegador no admite este reproductor.</video>
                }
                else if (kind == AttachmentViewKind.Pdf)
                {
                    <AttachmentPdf Url="@PreviewUrl(active)" FileName="@active.FileName" @key="active.Id" />
                }
                else if (kind == AttachmentViewKind.Text)
                {
                    <article class="attachment-document"><p class="eyebrow">TEXTO DEL DOCUMENTO</p><p class="topic-scope">@active.ExtractionStatus. Esta vista conserva el texto disponible; el archivo original mantiene su formato.</p><p class="preserved-text">@active.ExtractedText</p></article>
                }
                else
                {
                    <div class="attachment-viewer-empty"><Icon Name="file" Size="44" /><h3>Tu archivo está guardado.</h3><p>Este formato no tiene una vista previa disponible. Podés abrir el original con una aplicación compatible.</p></div>
                }
            </div>
            <footer class="attachment-viewer-footer">
                <div class="attachment-viewer-navigation">
                    <button type="button" class="viewer-control previous-file" @onclick="() => Navigate(-1)" aria-label="Adjunto anterior" disabled="@(Files.Count < 2)"><Icon Name="arrow" Size="22" /></button>
                    <span>@SizeLabel(active.Size)@(HeicImageService.IsHeic(active.ContentType) ? " · Vista JPG" : "")</span>
                    <button type="button" class="viewer-control" @onclick="() => Navigate(1)" aria-label="Adjunto siguiente" disabled="@(Files.Count < 2)"><Icon Name="arrow" Size="22" /></button>
                </div>
                <a class="viewer-download" href="@($"/adjuntos/{active.Id}")" download><Icon Name="download" Size="17" /> Descargar original</a>
            </footer>
            @if (Files.Count > 1)
            {
                <nav class="attachment-thumbnails" aria-label="Adjuntos de esta entrada">
                    @foreach (var file in Files)
                    {
                        <button type="button" @key="file.Id" class="attachment-thumbnail @(file.Id == active.Id ? "selected" : "")"
                                @onclick="() => Select(file.Id)" aria-label="@($"Abrir {file.FileName}")" aria-current="@(file.Id == active.Id ? "true" : null)">
                            @if (AttachmentPresentation.Kind(file) == AttachmentViewKind.Image) { <img src="@PreviewUrl(file)" alt="" loading="lazy" /> }
                            else { <Icon Name="@AttachmentPresentation.Icon(file)" Size="24" /> }
                        </button>
                    }
                </nav>
            }
        </div>
    </dialog>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<JournalAttachment> Files { get; set; } = [];
    [Parameter] public bool Compact { get; set; }
    private readonly string _titleId = "attachment-title-" + Guid.NewGuid().ToString("N");
    private Guid? _activeId;
    private bool _failed;
    private bool _zoomed;
    private bool _disposed;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AttachmentGallery>? _reference;
    private JournalAttachment? Current => Files.FirstOrDefault(file => file.Id == _activeId);
    private int CurrentIndex => Files.Select(file => file.Id).ToList().IndexOf(_activeId ?? Guid.Empty);
    private static string PreviewUrl(JournalAttachment file) => $"/adjuntos/{file.Id}/vista";
    private static string SizeLabel(long size) => size >= 1024 * 1024 ? $"{size / (1024d * 1024):0.0} MB" : $"{Math.Max(1, size / 1024d):0} KB";

    private void Open(Guid id) { _activeId = id; _failed = false; _zoomed = false; }
    private void MediaFailed(Guid id) { if (_activeId == id) _failed = true; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Current is null || _disposed) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["attachment-gallery.js"]);
            _reference ??= DotNetObjectReference.Create(this);
            if (Current is not null && !_disposed) await _module.InvokeVoidAsync("show", _dialog, _reference);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    private async Task StopMedia()
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("stopMedia", _dialog); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
    private async Task Select(Guid id)
    {
        if (id == _activeId) return;
        await StopMedia();
        Open(id);
    }
    [JSInvokable] public async Task Navigate(int direction)
    {
        if (Current is null || Files.Count < 2) return;
        var index = (CurrentIndex + (direction < 0 ? -1 : 1) + Files.Count) % Files.Count;
        await Select(Files[index].Id);
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public async Task Close()
    {
        await StopMedia();
        _activeId = null;
        await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await StopMedia();
        _reference?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
    }
}
