<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "mic":
            <rect x="9" y="2" width="6" height="13" rx="3" /><path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3m-4 0h8" />
            break;
        case "stop":
            <rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" />
            break;
        case "refresh":
            <path d="M20 7v5h-5M4 17v-5h5M6.1 6.1a8 8 0 0 1 13.2 3.4M4.7 14.5a8 8 0 0 0 13.2 3.4" />
            break;
        case "arrow":
            <path d="M4 12h15m-6-6 6 6-6 6" />
            break;
        case "image":
            <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8" cy="8" r="1.5" /><path d="m3 17 5-5 4 4 4-7 5 8" />
