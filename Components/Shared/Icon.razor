            break;
        case "chevron":
            <path d="m6 9 6 6 6-6" />
            break;
        case "leaf":
            <path d="M5 19c.6-6.5 5.1-12 14.5-14-1.1 9.6-6.2 13.1-11.5 11.5M4.5 20 15 9.5" />
            break;
        case "lock":
            <rect x="5" y="10" width="14" height="11" rx="2.2" /><path d="M8 10V7a4 4 0 1 1 8 0v3m-4 4v3" />
            break;
        case "copy":
            <rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" />
            break;
        case "print":
            <path d="M7 8V3.5h10V8M6.5 17H4V8h16v9h-2.5M7 14h10v6.5H7zM16 11h1" />
