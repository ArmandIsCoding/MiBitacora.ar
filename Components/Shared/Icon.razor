        case "calendar":
            <rect x="3.5" y="5.5" width="17" height="15" rx="2" /><path d="M7.5 3.5v4m9-4v4m-13 3h17M8 14h.01m4-.01h.01m4 0h.01M8 17h.01m4 0h.01" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
            break;
        case "quote":
            <path d="M4 13c0-3 1.5-5 4-6m3 6c0-3 1.5-5 4-6M4 13h4v4H4zm7 0h4v4h-4z" />
            break;
        case "info":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 11v5m0-8h.01" />
            break;
