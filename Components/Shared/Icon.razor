            break;
        case "shrink":
            <path d="M3 8h5V3m8 0v5h5M8 21v-5H3m13 5v-5h5" />
            break;
        case "zoom":
            <circle cx="10" cy="10" r="6.5" /><path d="m15 15 6 6M7 10h6m-3-3v6" />
            break;
        case "up":
            <path d="M12 19V5m-6 6 6-6 6 6" />
            break;
        case "book":
            <path d="M12 5.5a10 10 0 0 0-8.5-1V19a10 10 0 0 1 8.5 1 10 10 0 0 1 8.5-1V4.5a10 10 0 0 0-8.5 1Zm0 0V20M6.5 8.5c1 0 1.8.2 2.6.5m-2.6 3c1 0 1.8.2 2.6.5m5.8-3.5c.8-.3 1.6-.5 2.6-.5m-2.6 4c.8-.3 1.6-.5 2.6-.5" />
            break;
        case "spark":
            <path d="M10 2.8c.9 5 2.2 6.3 7.2 7.2-5 .9-6.3 2.2-7.2 7.2C9.1 12.2 7.8 10.9 2.8 10c5-.9 6.3-2.2 7.2-7.2Zm8 10.7c.4 2.5 1 3.1 3.5 3.5-2.5.4-3.1 1-3.5 3.5-.4-2.5-1-3.1-3.5-3.5 2.5-.4 3.1-1 3.5-3.5Z" />
            break;
        case "pen":
            <path d="m4 16-.8 4.8 4.8-.8L20 8a2.8 2.8 0 0 0-4-4L4 16Zm10-10 4 4M4 16l4 4" />
            break;
        case "paperclip":
            <path d="m8 13.5 6.7-6.7a2 2 0 0 1 2.8 2.8l-8.3 8.3a3.7 3.7 0 0 1-5.2-5.2L13 3.8a5 5 0 0 1 7.1 7.1l-9 9" />
            break;
        case "camera":
            <path d="M3 7.5h4l1.6-2.3h6.8L17 7.5h4v12H3z" /><circle cx="12" cy="13.4" r="3.1" />
            break;
        case "note":
            <path d="M4.5 3.5h15v11l-5 6h-10zM14.5 20.5v-6h5M8 8h8m-8 3.5h6" />
            break;
        case "bookmark":
            <path d="M6 4h12v16l-6-4.2L6 20z" />
            break;
        case "check":
            <path d="m5 12 4.2 4.2L19 6.5" />
            break;
        case "settings":
            <circle cx="12" cy="8" r="3.5" /><path d="M4.7 20v-1a5 5 0 0 1 5-5h4.6a5 5 0 0 1 5 5v1" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "x":
            <path d="m6 6 12 12M18 6 6 18" />
            break;
        case "file":
            <path d="M5 3.5h9l5 5V21H5zM14 3.5v5h5M8.5 13h7m-7 3.5h5" />
            break;
        case "download":
