@if (!IsPaid)
{
    <aside class="plan-notice" aria-label="Tu plan gratuito">
        <div>
            <strong>Tu espacio sigue siendo gratuito.</strong>
            <p>La IA local puede tardar más y sus devoluciones pueden ser menos precisas. Con el Plan Profundo accedés a un modelo de mayor capacidad para explorar conexiones, desarrollar tus reflexiones y preparar informes más profundos.</p>
        </div>
        <a class="btn btn-outline" href="/Account/Manage/Subscription">Conocer el Plan Profundo</a>
    </aside>
}
@code { [Parameter] public bool IsPaid { get; set; } }
