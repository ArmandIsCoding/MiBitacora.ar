<article class="reflection-card @(IsConversation ? "conversation-reply" : "")" aria-label="Respuesta de Mi Bitácora">
    <header class="reflection-meta">
        <span class="reflection-mark"><Icon Name="spark" Size="19" /></span>
        <span class="eyebrow">MI BITÁCORA · IA</span>
        @if (Reflection.IsDemo)
        {
            <span class="soft-badge">Muestra</span>
        }
    </header>

    @if (!IsConversation) { <h3>@Reflection.Title</h3> }
    <p class="reflection-overview">@Reflection.Overview</p>

    @if (IsConversation && Reflection.OpenQuestions.FirstOrDefault() is { } focusQuestion)
    {
        <p class="conversation-question">@focusQuestion</p>
    }

    @if (Reflection.Themes.Count > 0)
    {
        <details class="reflection-details" open="@(!IsConversation)">
        <summary>En qué se apoya esta lectura <Icon Name="chevron" Size="16" /></summary>
        <div class="reflection-themes">
            @foreach (var theme in Reflection.Themes)
            {
                <section class="reflection-theme">
                    <h4>@theme.Title</h4>
                    <p>@theme.Detail</p>
                    @if (!string.IsNullOrWhiteSpace(theme.Quote))
                    {
                        <blockquote><Icon Name="quote" Size="17" /><span>«@theme.Quote»</span></blockquote>
                    }
                    @if (!string.IsNullOrWhiteSpace(theme.Source))
                    {
                        <small>@theme.Source</small>
                    }
                </section>
            }
        </div>
        </details>
    }

    @if (!IsConversation && Reflection.OpenQuestions.Count > 0)
    {
        <details class="reflection-details">
            <summary>Preguntas para explorar <Icon Name="chevron" Size="16" /></summary>
            <ul>
                @foreach (var question in Reflection.OpenQuestions)
                {
                    <li>@question</li>
                }
            </ul>
        </details>
    }

    @if (Reflection.SessionTopics.Count > 0)
    {
        <details class="reflection-details">
            <summary>Temas para conversar <Icon Name="chevron" Size="16" /></summary>
            <ul>
                @foreach (var topic in Reflection.SessionTopics)
                {
                    <li>@topic</li>
                }
            </ul>
        </details>
    }

    @if (!string.IsNullOrWhiteSpace(Reflection.NextStep))
    {
        <p class="reflection-next"><Icon Name="leaf" Size="19" /> <span>@Reflection.NextStep</span></p>
    }
    @if (Reflection.ContextSources is { Count: > 0 } memories)
    {
        <details class="reflection-details conversation-sources">
            <summary>Antecedentes consultados (@memories.Count) <Icon Name="chevron" Size="16" /></summary>
            <p class="topic-scope">Fragmentos que la IA tuvo a mano para responder. Podés revisar si la conexión tiene sentido para vos.</p>
            @foreach (var memory in memories)
            {
                <figure><figcaption>@memory.Label @if (memory.CreatedUtc is { } date) { <span>· @date.ToString("d/M/yyyy")</span> }</figcaption>
                <blockquote>@memory.Excerpt</blockquote>
                @if (memory.EntryId is { } id) { <a href="@($"/entrada/{id}?origen=chat")" target="_blank" rel="noopener">Abrir entrada completa</a> }
                </figure>
            }
        </details>
    }
    @if (Reflection.GeneratedUtc is { } generated)
    {
        <small class="reply-date">Respuesta generada el @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(generated, DateTimeKind.Utc), TimeZone).ToString("d/M/yyyy")</small>
    }
    @if (SaveAsNote.HasDelegate || ToggleSession.HasDelegate)
    {
    <footer class="reflection-actions">
        <button class="quiet-action" type="button" @onclick="SaveAsNote" disabled="@Busy"><Icon Name="note" Size="17" /> Hacer una notita</button>
        <button class="quiet-action" type="button" @onclick="ToggleSession" aria-pressed="@Selected" disabled="@Busy">
            <Icon Name="@(Selected ? "check" : "bookmark")" Size="17" /> @(Selected ? "En tu hoja" : "Marcar para retomar")
        </button>
    </footer>
    }
</article>

@code {
    [Inject] private TimeZoneInfo TimeZone { get; set; } = TimeZoneInfo.Utc;
    private bool IsConversation => Reflection.ConversationVersion >= 1 && !Reflection.IsDemo;
    [Parameter, EditorRequired] public JournalReflection Reflection { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback SaveAsNote { get; set; }
    [Parameter] public EventCallback ToggleSession { get; set; }
}
