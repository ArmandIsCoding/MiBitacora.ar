@page "/compartido"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject TherapyShareService Shares
@inject IJSRuntime JS
@inject ILogger<Compartido> Logger

<PageTitle>Recorrido compartido · Mi Bitácora</PageTitle>
<HeadContent><meta name="robots" content="noindex,nofollow,noarchive" /></HeadContent>
@if (_share is { } shared)
{
    <SharedTherapySpace @key="shared.Revision" Snapshot="shared.Snapshot" InitialTab="@InitialView" ExpiresUtc="shared.ExpiresUtc" Revision="shared.Revision" ValidateAccess="ValidateAsync" />
}
else
{
    <header class="site-header wrap"><Brand /></header><main class="shared-unavailable wrap"><Icon Name="@(_loading ? "graph" : "lock")" Size="44" /><h1>@(_loading ? "Abriendo el recorrido…" : "Este enlace no está disponible.")</h1><p role="status">@(_loading ? "Preparando la versión compartida de Mi Bitácora." : "Puede haber vencido o haber sido revocado. Pedile una versión nueva a quien lo compartió.")</p></main>
}

@code {
    [SupplyParameterFromQuery(Name = "vista")] public string InitialView { get; set; } = "mapa";
    private OpenTherapyShare? _share;
    private string? _token;
    private bool _loading = true;
    private IJSObjectReference? _module;
    private Task? _watch;
    private readonly CancellationTokenSource _lifetime = new();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./therapy-share.js");
            _token = await _module.InvokeAsync<string?>("readToken");
            _share = await Shares.OpenAsync(_token, _lifetime.Token);
            if (_share is not null) _watch = WatchAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { Logger.LogWarning("No se pudo abrir una versión compartida."); }
        finally { _loading = false; if (!_lifetime.IsCancellationRequested) StateHasChanged(); }
    }
    private async Task<bool> ValidateAsync()
    {
        if (_share is null || _token is null) return false;
        try {
            var revision = await Shares.GetRevisionAsync(_token, _lifetime.Token);
            if (revision is null) { _share = null; StateHasChanged(); return false; }
            if (revision != _share.Revision) { _share = await Shares.OpenAsync(_token, _lifetime.Token); StateHasChanged(); return false; }
            return true;
        } catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return false; }
        catch (Exception) { _share = null; StateHasChanged(); return false; }
    }
    private async Task WatchAsync()
    {
        try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30)); while (await timer.WaitForNextTickAsync(_lifetime.Token)) { await InvokeAsync(ValidateAsync); if (_share is null) return; } }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel(); if (_watch is not null) await _watch;
        try { if (_module is not null) await _module.DisposeAsync(); } catch (JSDisconnectedException) { } catch (TaskCanceledException) { }
        _lifetime.Dispose();
    }
}
